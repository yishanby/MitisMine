    "ulid": "3.0.2",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.9.0"
