{
  "name": "mitismine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx apps/control-plane/src/main.ts",
    "start": "node --env-file=.env.local dist/apps/control-plane/src/main.js",
